# Dashboard configuration. Copy to .env.local for development, and set the same
# keys in Vercel for Production.
#
# The values below are working development defaults, committed deliberately so a
# fresh clone runs without setup. They are safe only because the dashboard is
# running on fixture data. BOTH MUST BE REPLACED IN PRODUCTION — a published
# session secret lets anyone forge a signed admin cookie.

# Signs the session cookie. Must be at least 32 characters; without a valid one
# the dashboard refuses every sign-in rather than running unsigned.
# Generate a real one with: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=dev-only-secret-at-least-32-characters-long-abc

# The admin portal password. The only password not read from the roster —
# participants and guests sign in with their own two-word phrase.
DASHBOARD_ADMIN_PASSWORD=dcmc-admin

# --- Airtable (optional) ---
# Without these the dashboard runs on the fixtures in src/server/data/fixtures.ts.
# With them, the attendee roster comes live from the "Admit Confirmation" table.
# Create a token at https://airtable.com/create/tokens scoped to this base with
# data.records:read, data.records:write and schema.bases:read.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=appZ3PpQjBx0UzJ3u
